COMPOSE_PROJECT_NAME={{ obs_compose_project_name }}
TZ={{ timezone | default('UTC') }}
ADMIN_BIND_ADDRESS={{ admin_bind_address | default('127.0.0.1') }}
ZABBIX_BIND_ADDRESS={{ zabbix_bind_address | default('127.0.0.1') }}
TELEMETRY_BIND_ADDRESS={{ telemetry_bind_address | default('127.0.0.1') }}
CONTAINER_LOG_MAX_SIZE={{ container_log_max_size | default('10m') }}
CONTAINER_LOG_MAX_FILES={{ container_log_max_files | default('3') }}

POSTGRES_IMAGE={{ postgres_image | default('postgres:17.11-alpine3.24') }}
ZABBIX_DB_NAME={{ zabbix_db_name | default('zabbix') }}
ZABBIX_DB_USER={{ zabbix_db_user | default('zabbix') }}
ZABBIX_DB_PASSWORD={{ zabbix_db_password }}

ZABBIX_SERVER_IMAGE={{ zabbix_server_image | default('zabbix/zabbix-server-pgsql:7.4.14-alpine') }}
ZABBIX_WEB_IMAGE={{ zabbix_web_image | default('zabbix/zabbix-web-nginx-pgsql:7.4.14-alpine') }}
ZBX_STARTPOLLERS={{ zbx_startpollers | default('10') }}
ZBX_STARTPINGERS={{ zbx_startpingers | default('5') }}
ZBX_STARTDISCOVERERS={{ zbx_startdiscoverers | default('2') }}
ZBX_CACHESIZE={{ zbx_cachesize | default('32M') }}
ZBX_HISTORYCACHESIZE={{ zbx_historycachesize | default('16M') }}
ZBX_TRENDCACHESIZE={{ zbx_trendcachesize | default('16M') }}
ZABBIX_SERVER_PORT={{ zabbix_server_port | default('10051') }}
ZABBIX_WEB_PORT={{ zabbix_web_port | default('8080') }}

GRAFANA_IMAGE={{ grafana_image | default('grafana/grafana:13.1.4') }}
GRAFANA_ADMIN_USER={{ grafana_admin_user | default('admin') }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
GRAFANA_SECRET_KEY={{ grafana_secret_key }}
GRAFANA_ROOT_URL={{ grafana_root_url | default('http://localhost:3000') }}
GRAFANA_ZABBIX_PLUGIN_VERSION={{ grafana_zabbix_plugin_version | default('6.6.0') }}
GF_FEATURE_TOGGLES_ENABLE={{ gf_feature_toggles_enable | default('') }}
GRAFANA_PORT={{ grafana_port | default('3000') }}

ALPINE_IMAGE={{ alpine_image | default('alpine:3.22.1') }}
LOKI_IMAGE={{ loki_image | default('grafana/loki:3.7.6') }}
OTEL_IMAGE={{ otel_image | default('otel/opentelemetry-collector-contrib:0.157.0') }}
OTLP_GRPC_PORT={{ otlp_grpc_port | default('4317') }}
OTLP_HTTP_PORT={{ otlp_http_port | default('4318') }}
JAEGER_IMAGE={{ jaeger_image | default('jaegertracing/jaeger:2.15.0') }}
JAEGER_UI_PORT={{ jaeger_ui_port | default('16686') }}
