COMPOSE_PROJECT_NAME=zabbix-obs
TZ=UTC

# Host exposure defaults. Keep 127.0.0.1 for a single-machine deployment.
# For trusted-LAN access, use the host's private IP and restrict the host firewall.
ADMIN_BIND_ADDRESS=127.0.0.1
ZABBIX_BIND_ADDRESS=127.0.0.1
TELEMETRY_BIND_ADDRESS=127.0.0.1
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3

# Database
POSTGRES_IMAGE=postgres:17.11-alpine3.24
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Zabbix
ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:7.4.14-alpine
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-pgsql:7.4.14-alpine
ZBX_STARTPOLLERS=10
ZBX_STARTPINGERS=5
ZBX_STARTDISCOVERERS=2
ZBX_CACHESIZE=32M
ZBX_HISTORYCACHESIZE=16M
ZBX_TRENDCACHESIZE=16M
ZABBIX_SERVER_PORT=10051
ZABBIX_WEB_PORT=8080

# Grafana
GRAFANA_IMAGE=grafana/grafana:13.1.4
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
GRAFANA_SECRET_KEY=CHANGE_ME_INDEPENDENT_RANDOM_32_BYTE_KEY
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ZABBIX_PLUGIN_VERSION=6.6.0
GF_FEATURE_TOGGLES_ENABLE=
GRAFANA_PORT=3000

# Logs / traces
ALPINE_IMAGE=alpine:3.22.1
LOKI_IMAGE=grafana/loki:3.7.6
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.157.0
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
JAEGER_IMAGE=jaegertracing/jaeger:2.15.0
JAEGER_UI_PORT=16686
